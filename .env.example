# Environment variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored (`.gitignore` has
# `.env*`); this file is the tracked template. Every name below is read by the
# code -- none are speculative.

# ─── Database ─────────────────────────────────────────────────────────────────
# Required at import time: db/index.ts constructs the Neon client from this on
# module load, so a missing value breaks the build, not just the request.
# Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://

# Throwaway database for the test suite. The suite is written to skip the
# database tests when this is unset; with it set they run for real.
# Tests apply the migrations themselves, so point it at an empty database.
TEST_DATABASE_URL=postgresql://

# ─── Clerk (authentication) ──────────────────────────────────────────────────
# Publishable key from the Clerk dashboard. The frontend API host is derived from
# it, which is what lets the Content-Security-Policy allow Clerk's script.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Server-side key. Required by clerkMiddleware; the app will not boot without it.
CLERK_SECRET_KEY=sk_test_

# Signing secret for the Clerk webhook at /api/webhooks/clerk. Only needed if
# you want user create/update/delete events mirrored into the local database.
CLERK_WEBHOOK_SECRET=whsec_

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained token. Needs read access to repository contents and pull requests
# for the repos you index; it is also used to bypass the unauthenticated rate
# limit, so a 60-token/hour anonymous account will not keep up with indexing.
GITHUB_TOKEN=github_pat_

# ─── LLM providers ────────────────────────────────────────────────────────────
# Google Gemini, used for chat completions (gemini-2.0-flash-001), query
# classification, and commit summaries.
GEMINI_API_KEY=

# OpenRouter, used only for embedding generation
# (qwen/qwen3-embedding-8b, 768 dimensions).
OPENROUTER_API_KEY=sk-or-

# ─── Optional ────────────────────────────────────────────────────────────────
# Where `bun run db:backup` writes dumps. Must be outside the repository — the
# script refuses to write inside the working tree. Defaults to a sibling
# directory, ../gitvision-backups.
# BACKUP_DIR=/var/backups/gitvision

# Base URL the Playwright end-to-end suite points at. Defaults to
# http://localhost:3000.
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
